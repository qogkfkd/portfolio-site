    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "playwright test",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.2",
