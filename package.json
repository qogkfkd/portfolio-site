{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "astro build && wrangler deploy",
    "preview": "astro preview",
    "types": "wrangler types",
    "check": "wrangler types && astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
