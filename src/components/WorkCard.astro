---
import type { Work } from "../lib/types";
import { fieldColor } from "../lib/works/fieldColor";
import { isAwarded } from "../lib/works/filter";
import { yearOf } from "../lib/works/sort";
import { summaryOf } from "../lib/works/summary";

interface Props {
  work: Work;
  list: "featured" | "all";
  coverUrl?: string | null;
}

const { work, list, coverUrl = null } = Astro.props;
const href = `/works/${encodeURIComponent(work.slug)}`;
const color = fieldColor(work.fields[0]);
const meta = [work.competition, `${yearOf(work)}년`].filter((part) => part !== null).join(" · ");
---

<article class:list={["card", { "card-large": list === "featured" }]} data-list={list} data-work={work.slug}>
  <div class="cover">
    {
      coverUrl ? (
        <img src={coverUrl} alt="" loading="lazy" />
      ) : (
        <div class="cover-fallback" style={`--fb-bg:${color.bg};--fb-fg:${color.fg}`} aria-hidden="true">
          <span>{work.title}</span>
        </div>
      )
    }
  </div>
  <div class="body">
    <ul class="tags">{work.fields.map((field) => <li class="tag">{field}</li>)}</ul>
    <h3 class="title"><a href={href}>{work.title}</a></h3>
    <p class="summary">{summaryOf(work)}</p>
    <div class="meta">
      <span>{meta}</span>
      {isAwarded(work) && <span class="badge-award">{work.award}</span>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .card:hover {
    border-color: #cfd3da;
    box-shadow: 0 10px 30px -18px rgba(17, 20, 24, 0.35);
    transform: translateY(-2px);
  }
  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .cover {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
  }
  .card-large .cover {
    aspect-ratio: 16 / 9;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-fallback {
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding: 20px;
    background: var(--fb-bg);
    color: var(--fb-fg);
  }
  .cover-fallback span {
    display: -webkit-box;
    overflow: hidden;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .card-large .cover-fallback span {
    font-size: 30px;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 20px;
  }
  .title {
    font-size: 19px;
    font-weight: 700;
  }
  .card-large .title {
    font-size: 22px;
  }
  .title a {
    text-decoration: none;
  }
  .title a:focus-visible {
    outline: none;
  }
  .title a::after {
    position: absolute;
    inset: 0;
    content: "";
  }
  .summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 15px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 6px;
    color: var(--muted);
    font-size: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
